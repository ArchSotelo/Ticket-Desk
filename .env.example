# PLANTILLA PÚBLICA: no contiene credenciales válidas.
# Local: desde backend, ejecutar cp ../.env.example .env y completar los valores privados.
# Docker Compose: copiar este archivo a .env en la raíz del proyecto.
# No publicar el archivo .env que contiene tus valores reales.

# MYSQL DEL BACKEND — todas deben declararse.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=TicketDeskDB
DB_USER=ticket_app
DB_PASSWORD=
APP_TIMEZONE=America/Lima
DB_TIMEZONE=America/Lima

# JWT — obligatorio; generar con openssl rand -hex 32 y pegar el resultado aquí, en tu .env privado.
APP_JWT_SECRET=

# PRIMER ARRANQUE — obligatorias solo si el backend inicializa una base vacía.
# Mínimo 8 caracteres y máximo 72 bytes UTF-8. No usar la misma contraseña para todas las cuentas.
APP_SEED_ADMIN_PASSWORD=
APP_SEED_TECHNICIAN_PASSWORD=
APP_SEED_CLIENT_PASSWORD=

# ADJUNTOS — declarar todas; las credenciales MinIO pueden quedar vacías con LOCAL.
APP_STORAGE_PROVIDER=LOCAL
APP_STORAGE_LOCAL_UPLOAD_DIR=uploads
APP_STORAGE_MINIO_ENDPOINT=http://localhost:9000
APP_STORAGE_MINIO_ACCESS_KEY=
APP_STORAGE_MINIO_SECRET_KEY=
APP_STORAGE_MINIO_BUCKET_NAME=ticket-attachments

# CORREO — declarar todas; usuario y contraseña pueden quedar vacíos con envío desactivado.
APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# SOLO DOCKER — no son necesarias para ejecutar el backend con Maven.
# Compose reemplaza DB_HOST, DB_PORT, DB_NAME, DB_USER y las credenciales de MinIO para los contenedores.
# El esquema incluido crea TicketDeskDB; conservar ese nombre al usarlo sin modificaciones.
MYSQL_DATABASE=TicketDeskDB
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3307
BACKEND_PORT=8080
FRONTEND_PORT=4200
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_BUCKET_NAME=ticket-attachments
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
TZ=America/Lima
