# Instalar en el Nginx del servidor (host), no dentro del contenedor frontend.
# Cambia el dominio y las rutas por los datos reales del servidor.

server {
    listen 80;
    listen [::]:80;
    server_name tickets.example.com;

    # Mantiene HTTP disponible para redirección y validación/renovación TLS.
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name tickets.example.com;

    ssl_certificate     /etc/letsencrypt/live/tickets.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tickets.example.com/privkey.pem;

    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:4200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Necesario para el WebSocket que el Nginx del frontend reenvía al backend.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
