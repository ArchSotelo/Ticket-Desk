# Plantilla Docker para copiar como .env en la raíz del proyecto.
# Sustituye los valores de ejemplo antes de iniciar los contenedores.

# Base de datos
MYSQL_DATABASE=TicketDeskDB
MYSQL_ROOT_PASSWORD=REEMPLAZAR_CON_SECRETO_LARGO_Y_UNICO
MYSQL_APP_USER=ticket_app
MYSQL_APP_PASSWORD=REEMPLAZAR_CON_OTRO_SECRETO_LARGO_Y_UNICO

# JWT: generar con `openssl rand -hex 32`
APP_JWT_SECRET=REEMPLAZAR_CON_SECRETO_GENERADO

# Contraseñas iniciales requeridas solo cuando la base de datos está vacía
APP_SEED_ADMIN_PASSWORD=REEMPLAZAR_CON_PASSWORD_INICIAL_ADMIN
APP_SEED_TECHNICIAN_PASSWORD=REEMPLAZAR_CON_PASSWORD_INICIAL_TECNICO
APP_SEED_CLIENT_PASSWORD=REEMPLAZAR_CON_PASSWORD_INICIAL_CLIENTE

# Zona horaria
TZ=America/Lima
APP_TIMEZONE=America/Lima
DB_TIMEZONE=America/Lima

# Almacenamiento MinIO
APP_STORAGE_LOCAL_UPLOAD_DIR=uploads
MINIO_IMAGE=REEMPLAZAR_POR_IMAGEN_Y_VERSION_FIJAS
MINIO_ROOT_USER=REEMPLAZAR_USUARIO_MINIO
MINIO_ROOT_PASSWORD=REEMPLAZAR_CON_SECRETO_LARGO_Y_UNICO
MINIO_BUCKET_NAME=ticket-attachments

# Correo; mantener desactivado hasta configurar SMTP
APP_MAIL_ENABLED=false
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=25
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false

# Puerto local del frontend para el proxy inverso del servidor
FRONTEND_PORT=4200
